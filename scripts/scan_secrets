#!/bin/sh
# scan_secrets — R3 minimal mechanical gate (docs/standards/architecture.md
# §2 R3: no hardcoded keys/credentials; credential values never enter
# code/docs/logs/commits).
#
# MINIMAL, HOME-GRADE implementation: one tight ERE matched against the
# ADDED lines of a diff. The pattern set is meant to be EXTENDED as new
# leak shapes are learned (edit PAT below; keep it tight enough that a
# full-tree scan of this repository stays at zero hits — verify with a
# plain local run before committing a pattern change).
#
# Modes (auto-selected):
#   CI pull_request:  added lines of origin/$GITHUB_BASE_REF...$GITHUB_SHA
#   CI push:          added lines of before..after (github.event payload;
#                     jq is preinstalled on GitHub runners)
#   Fallback:         zero/unknown "before" (first push, force-push), a
#                     missing base ref or missing jq -> FULL-TREE diff
#                     (empty-tree..HEAD), i.e. the safe superset. The
#                     fallback always prints a notice, never silent.
#   Local (no GITHUB_* env): full-tree scan of the committed tree (HEAD).
#                     Uncommitted/untracked files are NOT covered.
#
# Pattern is case-sensitive on purpose: a case-insensitive match hits the
# known dummy in scripts/gen_compat_fixtures.py:31 (PASSWORD = "...pw").
# Names cover the realistic leak shapes (Rust/JSON/env keys; app_key is
# the baidu config spelling). Char class admits hex/base64-ish literals
# only, 20+ chars, quote-delimited — prose and short placeholders do not
# match.
#
# Usage: scripts/scan_secrets [repo-root]    (default: this repository)
# Requires: POSIX sh + git/grep/awk (+ jq for the push-event payload).
# Exit 0 = no match, 1 = matches listed on stderr (file:line: content).

set -eu

ROOT=${1:-$(dirname -- "$0")/..}
cd "$ROOT"

# This is a git-diff-based gate: no repo (or an unusable range) must be a
# loud failure, never a silent "OK".
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "scan_secrets: FAIL - not a git repository: $ROOT" >&2
    exit 2
}

PAT="(access_token|refresh_token|secret|appkey|api_key|app_key|password)[[:space:]]*[=:][[:space:]]*[\"'][A-Za-z0-9_+/=-]{20,}[\"']"

ZERO_SHA=0000000000000000000000000000000000000000
head_sha=${GITHUB_SHA:-HEAD}
mode=
from=
to=

if [ "${GITHUB_EVENT_NAME:-}" = pull_request ] && [ -n "${GITHUB_BASE_REF:-}" ]; then
    if base=$(git rev-parse --verify -q "origin/$GITHUB_BASE_REF" 2>/dev/null) && [ -n "$base" ]; then
        mode="pull_request added lines (origin/$GITHUB_BASE_REF...$head_sha)"
        # Three-dot semantics spelled out: diff from the merge base.
        from=$(git merge-base "$base" "$head_sha")
        to=$head_sha
    else
        echo "scan_secrets: notice - base ref origin/$GITHUB_BASE_REF not found; falling back to full tree" >&2
    fi
elif [ "${GITHUB_EVENT_NAME:-}" = push ] && [ -n "${GITHUB_EVENT_PATH:-}" ]; then
    if command -v jq >/dev/null 2>&1; then
        before=$(jq -r '.before // empty' "$GITHUB_EVENT_PATH" 2>/dev/null || echo)
    else
        before=
        echo "scan_secrets: notice - jq unavailable; falling back to full tree" >&2
    fi
    if [ -n "$before" ] && [ "$before" != "$ZERO_SHA" ] \
        && git cat-file -e "$before^{commit}" 2>/dev/null; then
        mode="push added lines ($before..$head_sha)"
        from=$before
        to=$head_sha
    else
        echo "scan_secrets: notice - no usable before commit (first push/force-push or missing); falling back to full tree" >&2
    fi
fi

if [ -z "$from" ]; then
    # Safe superset: diff everything committed at HEAD against the empty tree.
    from=$(git hash-object -t tree /dev/null)
    to=$head_sha
    mode="full tree (empty-tree..HEAD)"
fi

# git diff -U0 -> one hunk header per file region; awk tracks file + line
# number and re-emits each added line as "file:line: content" for grep.
# The diff goes through a temp file on purpose: POSIX sh has no
# pipefail, so piping directly would swallow a failed `git diff` and
# turn an unusable range into a silent "OK". With set -e, a failing
# diff (bad range) aborts here instead.
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
git diff --no-color -U0 "$from" "$to" > "$tmp"
added=$(awk '
    /^\+\+\+ / { file = substr($0, 7); next }
    /^@@/      { if (match($0, /\+[0-9]+/)) line = substr($0, RSTART + 1, RLENGTH - 1); next }
    /^\+/      { print file ":" line ": " substr($0, 2); line++ }
' "$tmp" | grep -E "$PAT" || true)

if [ -n "$added" ]; then
    echo "scan_secrets: FAIL - potential credential literal(s) in added lines [$mode]" >&2
    printf '%s\n' "$added" >&2
    exit 1
fi

echo "scan_secrets: OK - no pattern matches [$mode]"
